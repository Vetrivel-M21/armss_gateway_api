PORT=2092
APP_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=armss_gateway_db
JWT_SECRET=your_jwt_secret_key

# GoDaddy-hosted mailbox (implicit TLS / SMTPS on port 465).
SMTP_HOST=mail.arminfo.in
SMTP_PORT=465
SMTP_USERNAME=noreply@arminfo.in
SMTP_PASSWORD=your_mailbox_password
SMTP_FROM_ADDRESS=noreply@arminfo.in

# ARMSS Gateway installer OTP gate: installer POSTs to /api/v1/installer/*
# with this shared secret in X-Installer-Secret; the OTP is emailed to this
# admin address for the installing user to request by phone/chat.
INSTALLER_ADMIN_EMAIL=armssdirector@gmail.com
INSTALLER_API_SECRET=your_installer_shared_secret

# Desktop auto-update metadata. Leave blank to disable updates.
APP_UPDATE_VERSION=1.0.0
APP_UPDATE_URL=https://armssgateway.arminfo.in/api/v1/app/download
APP_UPDATE_SHA256=
APP_UPDATE_FILE=/opt/armss/ARMSS_Gateway_Setup.exe

# Shared secret the mis_desktop admin tile sends as X-Admin-Secret when
# listing portal users / saving their link grants.
ADMIN_API_SECRET=your_admin_shared_secret
